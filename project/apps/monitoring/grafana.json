{
  "title": "DevOps Final Platform Dashboard",
  "uid": "devops-final-platform",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["devops-final", "kubernetes", "authentik", "longhorn"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Node CPU Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}} CPU %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Node Memory Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{instance}} Memory %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Authentik Pod CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum by(pod) (rate(container_cpu_usage_seconds_total{namespace=\"authentik\", container!=\"\", pod=~\"authentik.*\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Authentik Pod Memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum by(pod) (container_memory_working_set_bytes{namespace=\"authentik\", container!=\"\", pod=~\"authentik.*\"}) / 1024 / 1024",
          "legendFormat": "{{pod}} MiB",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Authentik Service Endpoints",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "kube_endpoint_address_available{namespace=\"authentik\", endpoint=\"authentik\"}",
          "legendFormat": "Available endpoints",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pod Restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=~\"authentik|postgres|monitoring|argocd|longhorn-system\"}[10m])",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "PostgreSQL PVC Usage %",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "expr": "(kubelet_volume_stats_used_bytes{namespace=\"postgres\"} / kubelet_volume_stats_capacity_bytes{namespace=\"postgres\"}) * 100",
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Authentik Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "{namespace=\"authentik\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "PostgreSQL Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "expr": "{namespace=\"postgres\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "ArgoCD Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "{namespace=\"argocd\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Longhorn Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "expr": "{namespace=\"longhorn-system\"}",
          "refId": "A"
        }
      ]
    }
  ]
}